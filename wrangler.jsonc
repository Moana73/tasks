{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glass-tasks",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  // フロントエンド（scripts/build.mjs の出力）を同じ Worker から配信
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api と /auth だけ Worker を通し、それ以外は静的配信（Worker の実行回数を節約）
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glass-tasks",
      // `npx wrangler d1 create glass-tasks` の出力 ID に置き換えてください
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "ai": { "binding": "AI" },

  "vars": {
    // Google Cloud Console で作成した OAuth クライアント ID（公開情報なので vars でOK）
    "GOOGLE_CLIENT_ID": "REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
  // GOOGLE_CLIENT_SECRET は `npx wrangler secret put GOOGLE_CLIENT_SECRET` で登録（ここには書かない）
}
